{
 "dur": 79.2,
 "lines": [
  {
   "t0": 3.4,
   "t1": 9.22,
   "who": "N",
   "text": "Someone is playing in the next room, and the door is shut. Clara presses her ear against it."
  },
  {
   "t0": 9.22,
   "t1": 13.24,
   "who": "piano",
   "notes": [
    9.22,
    9.84,
    10.46,
    11.08,
    11.7
   ]
  },
  {
   "t0": 13.24,
   "t1": 20.72,
   "who": "N",
   "text": "Is it high or low? Is it the same tune as before, or a new one? She can\u2019t see the keys this time. She can only listen."
  },
  {
   "t0": 20.72,
   "t1": 24.71,
   "who": "B",
   "text": "Shall we listen with her? Is this note high, or low?"
  },
  {
   "t0": 24.71,
   "t1": 26.25,
   "who": "piano",
   "notes": [
    24.71
   ]
  },
  {
   "t0": 26.25,
   "t1": 28.45,
   "who": "pause",
   "text": "Pause and try."
  },
  {
   "t0": 28.45,
   "t1": 29.79,
   "who": "N",
   "text": "High."
  },
  {
   "t0": 29.79,
   "t1": 31.55,
   "who": "B",
   "text": "And this one?"
  },
  {
   "t0": 31.55,
   "t1": 33.09,
   "who": "piano",
   "notes": [
    31.55
   ]
  },
  {
   "t0": 33.09,
   "t1": 35.29,
   "who": "pause",
   "text": "Pause and try."
  },
  {
   "t0": 35.29,
   "t1": 36.61,
   "who": "N",
   "text": "Low."
  },
  {
   "t0": 36.61,
   "t1": 40.38,
   "who": "B",
   "text": "Now two little tunes. The same, or different?"
  },
  {
   "t0": 40.38,
   "t1": 42.54,
   "who": "piano",
   "notes": [
    40.38,
    41.0,
    41.62
   ]
  },
  {
   "t0": 42.54,
   "t1": 43.34,
   "who": "pause",
   "text": "Pause and try."
  },
  {
   "t0": 43.34,
   "t1": 45.5,
   "who": "piano",
   "notes": [
    43.34,
    43.96,
    44.58
   ]
  },
  {
   "t0": 45.5,
   "t1": 47.7,
   "who": "pause",
   "text": "Pause and try."
  },
  {
   "t0": 47.7,
   "t1": 50.11,
   "who": "N",
   "text": "The same tune, twice."
  },
  {
   "t0": 50.11,
   "t1": 50.91,
   "who": "pause",
   "text": "Pause and try."
  },
  {
   "t0": 50.91,
   "t1": 58.97,
   "who": "N",
   "text": "When the playing stops, Clara opens the door. There sits the Butler at the old practice piano, one finger still resting on a key."
  },
  {
   "t0": 58.97,
   "t1": 60.84,
   "who": "P",
   "text": "High, then low"
  },
  {
   "t0": 60.84,
   "t1": 63.08,
   "who": "P",
   "text": "And the same tune twice."
  },
  {
   "t0": 63.08,
   "t1": 70.43,
   "who": "N",
   "text": "The Butler writes one word in his little book: Correct. Good pianists listen first. The ear shows the fingers the way."
  },
  {
   "t0": 70.43,
   "t1": 71.03,
   "who": "pause",
   "text": "Pause and try."
  },
  {
   "t0": 71.03,
   "t1": 72.92,
   "who": "B",
   "text": "The Butler\u2019s note."
  },
  {
   "t0": 72.92,
   "t1": 77.04,
   "who": "B",
   "text": "Listen first. The ear tells the fingers where to go."
  },
  {
   "t0": 77.04,
   "t1": 79.2,
   "who": "piano",
   "notes": [
    77.04,
    77.66
   ]
  }
 ]
}