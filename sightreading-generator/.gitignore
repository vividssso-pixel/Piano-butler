# 2026-09-15: added after a first commit accidentally swept in ~5000
# generated/leftover files (123 MB) because nothing here was excluding
# them. Keep this in sync with .dockerignore's intent, though that file
# only controls what reaches the Docker build -- this is what controls
# what git tracks at all.

node_modules/

# Generated per-excerpt output (.ly/.pdf/.png/.midi/.mp3) from every local
# "npm start" test run -- purely ephemeral, never needs to be in version
# control.
server/output/

# Old Mission Bank / Explorer Bank on-disk records (both features retired).
storage/

# Retired dead-code UI files (Mission Bank removed 2026-09-15; the server
# route and nav link are already gone, these are just the leftover files).
client/public/mission-bank.html
client/public/mission-bank.js

# Anything staged for manual deletion that never got deleted.
_to_delete/

npm-debug.log
